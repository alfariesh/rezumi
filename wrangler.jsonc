{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Do not rename the Worker: its secrets, Durable Object namespace and the rezumi.app Custom Domain (attached in the
	// Cloudflare dashboard, deliberately not under "routes" so the CI token needs no zone permissions) belong to this name.
	"name": "vitaekit",
	"main": "apps/server/dist-cloudflare/index.js",
	// The app is served from the rezumi.app Custom Domain only; its APP_URL rejects sign-in from any other origin.
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"triggers": { "crons": ["* * * * *"] },
	"no_bundle": true,
	"find_additional_modules": true,
	"rules": [
		{ "type": "ESModule", "globs": ["index.js"], "fallthrough": false },
		{ "type": "CompiledWasm", "globs": ["*.wasm"], "fallthrough": false },
		{ "type": "Text", "globs": ["prompts/*.md", "hugeicons/*/*.json"], "fallthrough": false },
	],
	"assets": {
		"directory": "apps/server/dist-cloudflare/assets",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/index.html",
			"/ats-checker",
			"/api/*",
			"/uploads/*",
			"/mcp",
			"/mcp/*",
			"/.well-known/*",
			"/_prerender",
			"/_prerender/*",
			"/robots.txt",
			"/sitemap.xml",
			"/llms.txt",
			"/schema.json",
		],
	},
	"vars": {
		"NODE_ENV": "production",
		"CLOUDFLARE": "1",
		"STORAGE_BACKEND": "r2",
		"FLAG_DISABLE_IMAGE_PROCESSING": "true",
		"DEPLOYMENT_NAMESPACE": "production",
		"APP_URL": "https://rezumi.app",
		"SMTP_FROM": "Rezumi <noreply@rezumi.app>",
		// Plans apply to admin accounts only until launch (Phase 11): "on" opens them to everyone, "off" hides them.
		"BILLING_MODE": "admins",
		// Web portfolios stay hidden until launch (portfolio plan Phase 12): "admins" lets admin accounts try them, "on"
		// opens them to everyone. "off" keeps /<username> on the primary resume.
		"PORTFOLIO_MODE": "admins",
		// Custom domains through Cloudflare for SaaS. The token is the Worker secret CLOUDFLARE_SAAS_API_TOKEN; without it
		// nothing here is active. The target is the zone's fallback origin (docs/self-hosting/sharing-domains.mdx).
		"CUSTOM_DOMAIN_TARGET": "domains.rezumi.app",
		"CLOUDFLARE_SAAS_ZONE_ID": "",
		// The contact form's public Turnstile key; set with its secret (TURNSTILE_SECRET_KEY, a Worker secret) before
		// launch. Without both, the form isn't offered and Contact falls back to the email button.
		"TURNSTILE_SITE_KEY": "",
		// Polar production products (organization "rezumi"). Not secret; POLAR_ACCESS_TOKEN and POLAR_WEBHOOK_SECRET are
		// Worker secrets, set after these are live (the token without them fails startup).
		"POLAR_ENVIRONMENT": "production",
		"POLAR_PRODUCT_PLUS_MONTHLY": "ead42ea7-c6cd-49fd-a44e-0badb050c6b1",
		"POLAR_PRODUCT_PLUS_YEARLY": "0947661b-03eb-4d83-96cc-6cdda965145b",
		"POLAR_PRODUCT_PRO_AI_MONTHLY": "0b30a314-9c0f-4bf5-af18-7153a64c9b79",
		"POLAR_PRODUCT_PRO_AI_YEARLY": "3209453f-776c-4a7b-950e-76acff06cdb6",
	},
	"send_email": [{ "name": "EMAIL" }],
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f2e0cd8d0b084ed5bdbfb8a1de8a80dc" }],
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vitaekit" }],
	// Visitor breakdowns for portfolio statistics; the dataset is created on the first write. Read through ANALYTICS_SQL.
	"analytics_engine_datasets": [{ "binding": "PORTFOLIO_EVENTS", "dataset": "portfolio_events" }],
	"analytics": { "binding": "ANALYTICS_SQL" },
	"durable_objects": { "bindings": [{ "name": "COORDINATION", "class_name": "Coordination" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordination"] }],
	"limits": { "cpu_ms": 30000 },
	"observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
