{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Do not rename the Worker: its secrets, Durable Object namespace and the rezumi.app Custom Domain (attached in the
	// Cloudflare dashboard, deliberately not under "routes" so the CI token needs no zone permissions) belong to this name.
	"name": "vitaekit",
	"main": "apps/server/dist-cloudflare/index.js",
	// The app is served from the rezumi.app Custom Domain only; its APP_URL rejects sign-in from any other origin.
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"triggers": { "crons": ["* * * * *"] },
	"no_bundle": true,
	"find_additional_modules": true,
	"rules": [
		{ "type": "ESModule", "globs": ["index.js"], "fallthrough": false },
		{ "type": "CompiledWasm", "globs": ["*.wasm"], "fallthrough": false },
		{ "type": "Text", "globs": ["prompts/*.md", "hugeicons/*/*.json"], "fallthrough": false },
	],
	"assets": {
		"directory": "apps/server/dist-cloudflare/assets",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/index.html",
			"/ats-checker",
			"/api/*",
			"/uploads/*",
			"/mcp",
			"/mcp/*",
			"/.well-known/*",
			"/_prerender",
			"/_prerender/*",
			"/robots.txt",
			"/sitemap.xml",
			"/llms.txt",
			"/schema.json",
		],
	},
	"vars": {
		"NODE_ENV": "production",
		"CLOUDFLARE": "1",
		"STORAGE_BACKEND": "r2",
		"FLAG_DISABLE_IMAGE_PROCESSING": "true",
		"DEPLOYMENT_NAMESPACE": "production",
		"APP_URL": "https://rezumi.app",
		"SMTP_FROM": "Rezumi <noreply@rezumi.app>",
		// Plans are open to everyone since the launch (Phase 11). "admins" limits them to admin accounts, "off" hides them.
		"BILLING_MODE": "on",
		// Web portfolios stay hidden until launch (portfolio plan Phase 12): "admins" lets admin accounts try them, "on"
		// opens them to everyone. "off" keeps /<username> on the primary resume.
		"PORTFOLIO_MODE": "on",
		// Custom domains through Cloudflare for SaaS. The token is the Worker secret CLOUDFLARE_SAAS_API_TOKEN; without it
		// nothing here is active. The target is the zone's fallback origin (.agents/docs/self-hosting/sharing-domains.mdx).
		"CUSTOM_DOMAIN_TARGET": "domains.rezumi.app",
		"CLOUDFLARE_SAAS_ZONE_ID": "de7723edd44c3c4fc9279b0062d3a49c",
		// Browser Run reads pasted links that need JavaScript. Not secret; the token is the Worker secret
		// CLOUDFLARE_BROWSER_TOKEN (permission "Browser Run Edit"). Without it only the direct reader runs.
		"CLOUDFLARE_ACCOUNT_ID": "8be116534f7237b451f28adec91fbbbd",
		// The contact form's public Turnstile key; set with its secret (TURNSTILE_SECRET_KEY, a Worker secret) before
		// launch. Without both, the form isn't offered and Contact falls back to the email button.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF5qNivhOg0kkz1u",
		// Dodo Payments live-mode products (business "Rezumi"). Not secret. DODO_PAYMENTS_API_KEY (a key made in live mode)
		// and DODO_PAYMENTS_WEBHOOK_KEY are Worker secrets, set after these are deployed: the key without them, or a test-mode
		// key here, fails startup.
		"DODO_PAYMENTS_ENVIRONMENT": "live_mode",
		"DODO_PAYMENTS_PRODUCT_PLUS_MONTHLY": "pdt_0NrcLxDOzozrbdcuNkIZz",
		"DODO_PAYMENTS_PRODUCT_PLUS_YEARLY": "pdt_0NrcLxH3dG9NbNzj3GL0U",
		"DODO_PAYMENTS_PRODUCT_PRO_AI_MONTHLY": "pdt_0NrcLxLNpsfqo3e2jP7zY",
		"DODO_PAYMENTS_PRODUCT_PRO_AI_YEARLY": "pdt_0NrcLxOnM7iDIBRvf4zQN",
		// Sumopod (QRIS passes for Indonesia) in live mode. Not secret. SUMOPOD_API_KEY (the live project's key) and
		// SUMOPOD_WEBHOOK_SECRET (whsec_…, made when the webhook URL is saved in Sumopod) are Worker secrets; without the
		// key QRIS isn't offered and visitors from Indonesia pay by card.
		"SUMOPOD_ENVIRONMENT": "live",
		// Apify actor that reads LinkedIn profiles into the Profile. Not secret; this is also the default. APIFY_TOKEN is a
		// Worker secret: without it LinkedIn import is off.
		"APIFY_LINKEDIN_ACTOR": "harvestapi~linkedin-profile-scraper",
		// Rezumi AI (Anthropic) through the "rezumi" Cloudflare AI Gateway, for cost and error analytics. Not secret; kept
		// here because a deploy replaces dashboard variables. The gateway requires AI_GATEWAY_TOKEN (a Worker secret).
		"AI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/8be116534f7237b451f28adec91fbbbd/rezumi/anthropic/v1",
	},
	"send_email": [{ "name": "EMAIL" }],
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f2e0cd8d0b084ed5bdbfb8a1de8a80dc" }],
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vitaekit" }],
	// Resizes uploaded pictures (800 px JPEG, as sharp does on the Node server); see apps/server/src/cloudflare/images.ts.
	"images": { "binding": "IMAGES" },
	// Visitor breakdowns for portfolio statistics and job search cost and latency (job_search_events); a dataset is created
	// on its first write. Read through ANALYTICS_SQL.
	"analytics_engine_datasets": [
		{ "binding": "PORTFOLIO_EVENTS", "dataset": "portfolio_events" },
		{ "binding": "JOB_EVENTS", "dataset": "job_search_events" },
	],
	"analytics": { "binding": "ANALYTICS_SQL" },
	// Stops one address flooding the public portfolio routes; same numbers as rateLimitConfig.portfolioPublic.requests.
	// JOB_SEARCH_LIMITER holds back a burst of job searches per account; same numbers as rateLimitConfig.orpc.jobSearch.
	"ratelimits": [
		{ "name": "PORTFOLIO_PUBLIC_LIMITER", "namespace_id": "1101", "simple": { "limit": 600, "period": 60 } },
		{ "name": "JOB_SEARCH_LIMITER", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } },
	],
	// Career schedules: each cron tick sends one message per account with a due job, and each message runs that job in
	// its own invocation, side by side, instead of two per minute inside the tick. Create the queue once before the
	// first deploy: `pnpm exec wrangler queues create rezumi-career-jobs`.
	"queues": {
		"producers": [{ "binding": "CAREER_JOBS", "queue": "rezumi-career-jobs" }],
		"consumers": [
			{
				"queue": "rezumi-career-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 10,
				"max_retries": 0,
			},
		],
	},
	"durable_objects": { "bindings": [{ "name": "COORDINATION", "class_name": "Coordination" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordination"] }],
	// Runs the Worker next to PostgreSQL (Tencent ap-jakarta, reached through Hyperdrive) instead of next to the visitor:
	// a request makes several sequential queries, each ~1-3 ms near the database instead of 20-30 ms or more from far
	// away. Static assets are still served from the visitor's nearest location. The VPS only listens on localhost, so
	// a "host" probe can't reach it; GCP's Jakarta region is the nearest cloud region Placement knows.
	"placement": { "mode": "targeted", "region": "gcp:asia-southeast2" },
	"limits": { "cpu_ms": 30000 },
	"observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
