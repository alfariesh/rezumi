---
/**
 * An article. The header (topic, title, summary, credits) and the featured image span the column; below, the body
 * reads at 68 characters with "On this page" beside it from `xl` (folded above the body before that), then tags, the
 * article's call to action and three articles to read next.
 */
import type { PostProps } from "../lib/loaders";
import { Image, PortableText } from "emdash/ui";
import CtaPanel from "../components/CtaPanel.astro";
import JsonLd from "../components/JsonLd.astro";
import PostCard from "../components/PostCard.astro";
import PostHeading from "../components/PostHeading.astro";
import PostMeta from "../components/PostMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { getTranslator } from "../i18n/messages";
import BaseLayout from "../layouts/BaseLayout.astro";
import { absoluteUrl, categoryPath, homePath, postPath, tagPath } from "../lib/paths";

type Props = PostProps;

const {
	locale,
	settings,
	post,
	slug,
	seo,
	content,
	headings,
	readingMinutes,
	authors,
	topic,
	tags,
	related,
	cta,
	localeLinks,
	isPreview,
} = Astro.props;
const t = getTranslator(locale);
const { title, excerpt, featured_image: image, publishedAt, updatedAt } = post.data;
const path = postPath(locale, slug);
const showToc = headings.length >= 2;

const breadcrumbs = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ name: settings.siteTitle, path: homePath(locale) },
		...(topic ? [{ name: topic.label, path: categoryPath(locale, topic.slug) }] : []),
		{ name: title, path },
	].map((crumb, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: crumb.name,
		item: absoluteUrl(crumb.path),
	})),
};
---

<BaseLayout
	locale={locale}
	settings={settings}
	title={seo.title}
	socialTitle={seo.ogTitle}
	description={seo.description}
	path={path}
	canonical={seo.canonical}
	image={seo.ogImage}
	robots={isPreview ? "noindex, nofollow" : seo.robots}
	pageType="article"
	content={{ collection: "posts", id: post.data.id, slug }}
	article={{
		publishedTime: publishedAt?.toISOString() ?? null,
		modifiedTime: updatedAt.toISOString(),
		author: authors.join(", ") || null,
	}}
	localeLinks={localeLinks}
	currentTopic={topic?.slug}
	campaign={slug}
>
	<JsonLd data={breadcrumbs} />
	<article class="mx-auto w-full max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16 lg:px-8">
		<header class="max-w-3xl">
			{
				topic && (
					<a
						href={categoryPath(locale, topic.slug)}
						class="text-sm font-medium text-accent underline-offset-4 hover:underline"
					>
						{topic.label}
					</a>
				)
			}
			<h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl" {...post.edit.title}>
				{title}
			</h1>
			<p class="mt-5 text-lg text-pretty text-muted sm:text-xl" {...post.edit.excerpt}>{excerpt}</p>
			<PostMeta
				locale={locale}
				timezone={settings.timezone}
				publishedAt={publishedAt}
				updatedAt={updatedAt}
				readingMinutes={readingMinutes}
				authors={authors}
				class="mt-6 text-sm"
			/>
		</header>

		{
			image && (
				<figure class="mt-10 overflow-hidden rounded-3xl bg-default">
					<Image image={image} class="aspect-[16/9] size-full object-cover" sizes="(min-width: 1152px) 1088px, 100vw" priority />
					{image.caption && <figcaption class="px-4 py-3 text-center text-sm text-muted">{image.caption}</figcaption>}
				</figure>
			)
		}

		<div class:list={["mt-10 grid gap-12", showToc && "xl:grid-cols-[minmax(0,1fr)_16rem]"]}>
			<div class="min-w-0 max-w-[68ch]">
				{
					showToc && (
						<details class="group mb-8 rounded-2xl bg-surface p-4 shadow-surface xl:hidden">
							<summary class="cursor-(--cursor-interactive) text-sm font-semibold">{t("post.onThisPage")}</summary>
							<ul class="mt-3 flex flex-col gap-2 text-sm">
								{headings.map((heading) => (
									<li class:list={[heading.level === 3 && "ps-4"]}>
										<a href={`#${heading.id}`} class="text-muted hover:text-foreground">
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</details>
					)
				}

				<div class="prose" {...post.edit.content}>
					<PortableText value={content} components={{ block: { h2: PostHeading, h3: PostHeading } }} />
				</div>

				{
					tags.length > 0 && (
						<ul aria-label={t("post.tags")} class="mt-10 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<li>
									<a
										href={tagPath(locale, tag.slug)}
										class="chip chip--lg chip--default transition-colors hover:bg-default-hover"
									>
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					)
				}

				{
					cta && (
						<div class="mt-12">
							<CtaPanel locale={locale} kind={cta} placement="article" campaign={slug} />
						</div>
					)
				}
			</div>

			{
				showToc && (
					<aside class="hidden xl:block">
						<div class="sticky top-[calc(var(--header-height,4rem)+2rem)]">
							<TableOfContents locale={locale} headings={headings} />
						</div>
					</aside>
				)
			}
		</div>
	</article>

	{
		related.length > 0 && (
			<section aria-labelledby="related-title" class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28 lg:px-8">
				<h2 id="related-title" class="text-2xl font-semibold tracking-tight">
					{t("post.keepReading")}
				</h2>
				<ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{related.map((entry) => (
						<li class="flex">
							<PostCard locale={locale} timezone={settings.timezone} post={entry} />
						</li>
					))}
				</ul>
			</section>
		)
	}
</BaseLayout>
