---
import type { PostProps } from "../lib/loaders";
import { Image, PortableText } from "emdash/ui";
import CtaPanel from "../components/CtaPanel.astro";
import JsonLd from "../components/JsonLd.astro";
import PostCard from "../components/PostCard.astro";
import PostHeading from "../components/PostHeading.astro";
import PostMeta from "../components/PostMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { getTranslator } from "../i18n/messages";
import BaseLayout from "../layouts/BaseLayout.astro";
import { absoluteUrl, categoryPath, homePath, postPath, tagPath } from "../lib/paths";

type Props = PostProps;

const {
	locale,
	settings,
	post,
	slug,
	seo,
	content,
	headings,
	readingMinutes,
	authors,
	topic,
	tags,
	related,
	cta,
	localeLinks,
	isPreview,
} = Astro.props;
const t = getTranslator(locale);
const { title, excerpt, featured_image: image, publishedAt, updatedAt } = post.data;
const path = postPath(locale, slug);
const showToc = headings.length >= 2;

const breadcrumbs = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ name: settings.siteTitle, path: homePath(locale) },
		...(topic ? [{ name: topic.label, path: categoryPath(locale, topic.slug) }] : []),
		{ name: title, path },
	].map((crumb, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: crumb.name,
		item: absoluteUrl(crumb.path),
	})),
};
---

<BaseLayout
	locale={locale}
	settings={settings}
	title={seo.title}
	socialTitle={seo.ogTitle}
	description={seo.description}
	path={path}
	canonical={seo.canonical}
	image={seo.ogImage}
	robots={isPreview ? "noindex, nofollow" : seo.robots}
	pageType="article"
	content={{ collection: "posts", id: post.data.id, slug }}
	article={{
		publishedTime: publishedAt?.toISOString() ?? null,
		modifiedTime: updatedAt.toISOString(),
		author: authors.join(", ") || null,
	}}
	localeLinks={localeLinks}
	currentTopic={topic?.slug}
	campaign={slug}
	headerCta={cta ?? undefined}
>
	<JsonLd data={breadcrumbs} />
	<article class="journal-wrap pb-14 sm:pb-20">
		<header class="border-b border-separator pt-8 pb-8 sm:pt-12 sm:pb-10">
			<div class="mb-6 flex flex-wrap items-center gap-2 text-sm font-medium text-muted">
				<a href={homePath(locale)} class="rounded hover:text-foreground">{t("footer.blog")}</a>
				{topic && (
					<>
						<span aria-hidden="true">/</span>
						<a href={categoryPath(locale, topic.slug)} class="rounded hover:text-foreground">{topic.label}</a>
					</>
				)}
			</div>
			<h1 class="max-w-4xl text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl" {...post.edit.title}>
				{title}
			</h1>
			<p class="mt-4 max-w-3xl text-lg text-pretty text-muted sm:text-xl" {...post.edit.excerpt}>{excerpt}</p>
			<PostMeta
				locale={locale}
				timezone={settings.timezone}
				publishedAt={publishedAt}
				updatedAt={updatedAt}
				readingMinutes={readingMinutes}
				authors={authors}
				class="mt-6 text-sm"
			/>
		</header>

		{
			image && (
				<figure class="mt-10 overflow-hidden rounded-3xl bg-default">
					<Image image={image} class="aspect-[16/9] size-full object-cover" sizes="(min-width: 1152px) 1088px, 100vw" priority />
					{image.caption && <figcaption class="px-4 py-3 text-center text-sm text-muted">{image.caption}</figcaption>}
				</figure>
			)
		}

		<div class:list={["mt-6 sm:mt-10", showToc && "grid items-start gap-6 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14 xl:gap-20"]}>
			{showToc && (
				<aside class="top-[var(--header-height,4rem)] z-20 min-w-0 has-[[data-enhanced]]:sticky lg:sticky lg:top-[calc(var(--header-height,4rem)+1.5rem)]">
					<TableOfContents locale={locale} headings={headings} />
				</aside>
			)}
			<div class:list={["min-w-0 max-w-[70ch]", !showToc && "mx-auto"]}>
				<div class="prose" {...post.edit.content}>
					<PortableText value={content} components={{ block: { h2: PostHeading, h3: PostHeading } }} />
				</div>

				{
					tags.length > 0 && (
						<ul aria-label={t("post.tags")} class="mt-10 flex flex-wrap gap-2">
							{tags.map((tag) => (
								<li>
									<a
										href={tagPath(locale, tag.slug)}
										class="chip chip--lg chip--default transition-colors hover:bg-default-hover"
									>
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					)
				}

				{
					cta && (
						<div class="mt-12">
							<CtaPanel locale={locale} kind={cta} campaign={slug} />
						</div>
					)
				}
			</div>
		</div>
	</article>

	{
		related.length > 0 && (
			<section aria-labelledby="related-title" class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28 lg:px-8">
				<h2 id="related-title" class="text-2xl font-semibold tracking-tight">
					{t("post.keepReading")}
				</h2>
				<ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{related.map((entry) => (
						<li class="flex">
							<PostCard locale={locale} timezone={settings.timezone} post={entry} />
						</li>
					))}
				</ul>
			</section>
		)
	}
</BaseLayout>
