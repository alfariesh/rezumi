---
import { loadSearch } from "../../lib/loaders";
import NotFoundView from "../../views/NotFoundView.astro";
import SearchView from "../../views/SearchView.astro";

const result = await loadSearch(Astro, "id");
if (result.type === "redirect") {
	Astro.cache?.set(false);
	return Astro.redirect(result.location);
}
if (result.type === "not-found") Astro.response.status = 404;
---

{result.type === "ok" ? <SearchView {...result.props} /> : <NotFoundView />}
