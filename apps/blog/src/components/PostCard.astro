---
import type { Locale } from "../i18n/config";
import type { PostEntry } from "../lib/entries";
import { Image } from "emdash/ui";
import { entrySlug } from "../lib/entries";
import { postPath } from "../lib/paths";
import { readingMinutes } from "../lib/portable-text";
import Icon from "./Icon.astro";
import PostMeta from "./PostMeta.astro";

type Props = {
	locale: Locale;
	timezone: string;
	post: PostEntry;
	variant?: "card" | "feature";
	headingLevel?: "h2" | "h3";
};

const { locale, timezone, post, variant = "card", headingLevel: Heading = "h3" } = Astro.props;
const { title, excerpt, featured_image: image, publishedAt, content, terms } = post.data;
const topic = terms?.category?.[0];
const feature = variant === "feature";
---

<article class:list={[
	"group relative flex w-full flex-col overflow-hidden rounded-3xl bg-surface shadow-surface",
	"has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-focus",
	feature && image && "lg:grid lg:grid-cols-[2fr_3fr]",
]}>
	{image && (
		<div class:list={["overflow-hidden bg-default", feature ? "aspect-[16/9] lg:relative lg:aspect-auto" : "aspect-[16/9]"]}>
			<Image image={image} class={feature ? "size-full object-cover lg:absolute lg:inset-0" : "size-full object-cover"}
				sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw" />
		</div>
	)}
	<div class:list={["flex flex-1 flex-col p-6", feature && "sm:p-8"]}>
		{topic && <p class="mb-3 text-xs font-semibold text-muted">{topic.label}</p>}
		<Heading class:list={["font-semibold tracking-tight text-pretty", feature ? "max-w-2xl text-3xl sm:text-4xl" : "text-2xl"]}>
			<a href={postPath(locale, entrySlug(post))} class="outline-none after:absolute after:inset-0 group-hover:underline decoration-1 underline-offset-4">
				{title}
			</a>
		</Heading>
		<p class="mt-3 line-clamp-3 max-w-xl text-sm leading-relaxed text-pretty text-muted">{excerpt}</p>
		<div class="mt-auto flex items-end justify-between gap-3 pt-6">
			<PostMeta locale={locale} timezone={timezone} publishedAt={publishedAt} readingMinutes={readingMinutes(content)} class="pb-2 text-xs" />
			<span class="grid size-9 shrink-0 place-items-center rounded-full bg-default transition-colors group-hover:bg-accent group-hover:text-accent-foreground">
				<Icon name="arrow-up-right" size={16} />
			</span>
		</div>
	</div>
</article>
