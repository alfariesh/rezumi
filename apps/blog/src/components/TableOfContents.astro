---
import type { Locale } from "../i18n/config";
import type { HeadingAnchor } from "../lib/portable-text";
import { getTranslator } from "../i18n/messages";
import Icon from "./Icon.astro";

type Props = { locale: Locale; headings: readonly HeadingAnchor[] };

const { locale, headings } = Astro.props;
const t = getTranslator(locale);
---

<nav aria-label={t("post.onThisPage")} class="rounded-2xl bg-surface shadow-surface">
	<details data-toc class="group/toc">
		<summary class="flex min-h-14 cursor-(--cursor-interactive) list-none items-center gap-2.5 rounded-2xl px-4 py-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
			<Icon name="list" size={20} />
			<span>{t("post.onThisPage")}</span>
			<span class="ms-auto font-mono text-xs font-normal text-muted" data-toc-position aria-hidden="true"></span>
			<Icon name="chevron-down" size={16} class="shrink-0 text-muted transition-transform group-open/toc:rotate-180" />
		</summary>
		<ol class="toc-links mx-2 overflow-y-auto overscroll-contain border-t border-separator px-1 py-2">
			{headings.map((heading) => (
				<li>
					<a href={`#${heading.id}`} data-toc-link={heading.id}
						class:list={["toc-link", heading.level === 3 && "toc-child"]}>
						{heading.text}
					</a>
				</li>
			))}
		</ol>
	</details>
</nav>

<style>
	.toc-links {
		max-height: min(50dvh, calc(100dvh - var(--header-height, 4rem) - 6rem));
		scrollbar-width: thin;
	}
	.toc-link {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem 0.5rem 1.25rem;
		border-radius: var(--radius);
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.toc-child {
		padding-inline-start: 2.25rem;
	}
	.toc-child::after {
		content: "";
		position: absolute;
		inset-inline-start: 1.25rem;
		width: 0.45rem;
		border-top: 1px solid currentColor;
	}
	.toc-link:hover {
		background: var(--default);
		color: var(--foreground);
	}
	.toc-link[aria-current] {
		background: var(--accent-soft);
		color: var(--accent-soft-foreground);
		font-weight: 600;
	}
	.toc-link[aria-current]::before {
		content: "";
		position: absolute;
		inset-inline-start: 0.4rem;
		inset-block: 0.6rem;
		width: 3px;
		border-radius: 1rem;
		background: var(--accent);
	}
	@media (min-width: 64rem) {
		.toc-links {
			max-height: calc(100dvh - var(--header-height, 4rem) - 7rem);
		}
	}
</style>

<script>
	const toc = document.querySelector<HTMLDetailsElement>("[data-toc]");
	if (toc) {
		const desktop = window.matchMedia("(min-width: 64rem)");
		const syncLayout = () => {
			toc.open = desktop.matches;
		};
		syncLayout();
		desktop.addEventListener("change", syncLayout);
		toc.dataset.enhanced = "";

		const sections = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")).flatMap((link) => {
			const heading = document.getElementById(link.hash.slice(1));
			return heading ? [{ link, heading }] : [];
		});
		const position = toc.querySelector<HTMLElement>("[data-toc-position]");
		let active = -1;

		const markSection = () => {
			const offset = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 2;
			const index = Math.max(0, sections.findLastIndex(({ heading }) => heading.getBoundingClientRect().top <= offset));
			const section = sections[index];
			if (!section || active === index) return;
			sections[active]?.link.removeAttribute("aria-current");
			section.link.setAttribute("aria-current", "location");
			if (position) position.textContent = `${index + 1} / ${sections.length}`;
			active = index;
			// Keep the current link in a long desktop outline visible without moving the article.
			const list = section.link.closest("ol");
			if (desktop.matches && toc.open && list) {
				const box = section.link.getBoundingClientRect();
				const bounds = list.getBoundingClientRect();
				if (box.bottom > bounds.bottom) list.scrollTop += box.bottom - bounds.bottom;
				else if (box.top < bounds.top) list.scrollTop += box.top - bounds.top;
			}
		};
		let frame = 0;
		const schedule = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				markSection();
			});
		};
		markSection();
		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		toc.addEventListener("click", (event) => {
			if (desktop.matches || !(event.target instanceof Element)) return;
			if (event.target.closest("[data-toc-link]")) toc.open = false;
		});
	}
</script>
