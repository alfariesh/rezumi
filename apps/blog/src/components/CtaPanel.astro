---
import type { Locale } from "../i18n/config";
import type { CtaKind } from "../lib/cta";
import { getTranslator } from "../i18n/messages";
import { appLink } from "../lib/app-links";
import { CTA_DESTINATIONS } from "../lib/cta";
import Icon from "./Icon.astro";

type Props = { locale: Locale; kind: CtaKind; campaign: string };

const { locale, kind, campaign } = Astro.props;
const t = getTranslator(locale);
const href = appLink(CTA_DESTINATIONS[kind], { locale, placement: "article", campaign });
---

<section aria-labelledby="cta-article-title" class="relative isolate overflow-hidden rounded-3xl bg-surface p-6 shadow-surface sm:p-8">
	<div class="relative z-10 sm:w-2/3">
		<h2 id="cta-article-title" class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
			{t(`cta.${kind}.title`)}
		</h2>
		<p class="mt-3 text-sm leading-relaxed text-pretty text-muted">{t(`cta.${kind}.description`)}</p>
		<a href={href} class="button button--primary mt-5">
			{t(`cta.${kind}.action`)} <Icon name="arrow-right" size={16} />
		</a>
	</div>
	<div aria-hidden="true" class="absolute inset-y-0 end-0 hidden w-[29%] overflow-hidden rounded-es-[3rem] bg-accent-soft sm:block">
		<img src={`/editorial/meridian-${locale}.webp`} alt="" width="300" height="424" loading="lazy"
			class="absolute start-[18%] top-[18%] w-full max-w-none -rotate-6 shadow-lg" />
	</div>
</section>
