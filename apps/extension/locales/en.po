#: src/sidepanel/settings-screen.tsx
msgid "Account"
msgstr "Account"

#: src/sidepanel/connected-screen.tsx
msgid "Back"
msgstr "Back"

#: src/sidepanel/panel-error.tsx
msgid "Check for updates"
msgstr "Check for updates"

#. Button in the browser extension that signs in to Rezumi
#: src/sidepanel/connect-screen.tsx
msgid "Connect to Rezumi"
msgstr "Connect to Rezumi"

#: src/sidepanel/connect-screen.tsx
msgid "Couldn't connect to Rezumi. Try again."
msgstr "Couldn't connect to Rezumi. Try again."

#: src/sidepanel/settings-screen.tsx
msgid "Free"
msgstr "Free"

#: src/sidepanel/connected-screen.tsx
msgid "Loading your account…"
msgstr "Loading your account…"

#. Link in the browser extension to create a Rezumi account in a new tab
#: src/sidepanel/connect-screen.tsx
msgid "No account yet? <0>Sign up free</0>"
msgstr "No account yet? <0>Sign up free</0>"

#. Browser extension home screen when the open tab is not a job posting
#: src/sidepanel/connected-screen.tsx
msgid "Open a job posting to save it to Rezumi."
msgstr "Open a job posting to save it to Rezumi."

#. Button in the browser extension that opens the application tracker on the web
#: src/sidepanel/connected-screen.tsx
msgid "Open application tracker"
msgstr "Open application tracker"

#: src/sidepanel/settings-screen.tsx
msgid "Rezumi account"
msgstr "Rezumi account"

#: src/sidepanel/panel-error.tsx
msgid "Rezumi is having trouble right now."
msgstr "Rezumi is having trouble right now."

#. Lead sentence in the browser extension's side panel before the account is connected
#: src/sidepanel/connect-screen.tsx
msgid "Save job postings from any site to your application tracker."
msgstr "Save job postings from any site to your application tracker."

#. Title of the browser extension's side panel before the account is connected
#: src/sidepanel/connect-screen.tsx
msgid "Save jobs to Rezumi"
msgstr "Save jobs to Rezumi"

#: src/sidepanel/connected-screen.tsx
msgid "Settings"
msgstr "Settings"

#. Button in the browser extension that disconnects it from the Rezumi account
#: src/sidepanel/settings-screen.tsx
msgid "Sign out"
msgstr "Sign out"

#. Browser extension: the server ended the connection (signed out or access revoked)
#: src/sidepanel/connect-screen.tsx
msgid "The connection to Rezumi ended. Connect again to continue."
msgstr "The connection to Rezumi ended. Connect again to continue."

#: src/sidepanel/panel-error.tsx
msgid "Try again"
msgstr "Try again"

#: src/sidepanel/panel-error.tsx
msgid "Update the extension to continue."
msgstr "Update the extension to continue."

#: src/sidepanel/settings-screen.tsx
msgid "Version {EXTENSION_VERSION}"
msgstr "Version {EXTENSION_VERSION}"

#: src/sidepanel/panel-error.tsx
msgid "Wait a moment, then try again."
msgstr "Wait a moment, then try again."

#: src/sidepanel/connect-screen.tsx
#: src/sidepanel/panel-error.tsx
msgid "You're offline. Check your connection and try again."
msgstr "You're offline. Check your connection and try again."
