msgstr "Pilihan simpan"

#: src/sidepanel/posting-screen.tsx
msgid "Save to Rezumi"
msgstr "Simpan ke Rezumi"

#: src/sidepanel/save-error.tsx
msgid "Save without AI"
msgstr "Simpan tanpa AI"

#. Application stage: saved, not applied yet
#. Status choice when saving a job: not applied yet
#: src/sidepanel/posting-screen.tsx
#: src/sidepanel/status.ts
msgid "Saved"
msgstr "Disimpan"

