msgstr "Kamu sedang offline. Cek koneksimu lalu coba lagi."

#: src/sidepanel/save-error.tsx
msgid "You're offline. We kept what you entered here."
msgstr "Kamu sedang offline. Kami simpan isianmu di sini."

#: src/sidepanel/save-error.tsx
