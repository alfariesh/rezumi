					{
						"group": "Contributing",
						"pages": [
							"contributing/development",
							"contributing/architecture",
							"contributing/web-access",
							"contributing/career-platform",
							"contributing/deployment-checks"
						]
					},
					{
						"group": "Legal",
						"pages": ["legal/license", "legal/privacy-policy", "legal/terms-of-service"]
					}
				]
			},
			{
				"icon": "code",
				"tab": "API Reference",
				"openapi": "/spec.json"
			}
		],
		"global": {
			"anchors": [
				{
					"icon": "link",
					"anchor": "Rezumi",
					"href": "https://rezumi.app"
				},
				{
					"icon": "github",
					"anchor": "Source Code",
					"href": "https://github.com/reactive-resume/reactive-resume"
				}
			]
		}
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg",
		"href": "https://rezumi.app"
	},
	"navbar": {
		"links": [
			{
				"label": "Resume templates",
				"href": "https://rezumi.app/resume-templates"
			},
			{
				"label": "Support",
				"href": "https://github.com/reactive-resume/reactive-resume/issues"
			}
		],
		"primary": {
			"type": "button",
			"label": "Build your resume",
			"href": "https://rezumi.app/auth/register"
		}
	},
	"contextual": {
		"options": ["copy", "view"]
	},
	"footer": {
		"socials": {
			"website": "https://rezumi.app",
			"github": "https://github.com/reactive-resume/reactive-resume"
		}
	},
	"icons": {
		"library": "lucide"
	},
	"background": {
		"decoration": "grid"
	}
}
