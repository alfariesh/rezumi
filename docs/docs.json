						"group": "Server Configuration",
						"pages": [
							"self-hosting/environment-variables",
							"self-hosting/sharing-domains",
							"self-hosting/fonts",
							"self-hosting/job-search-and-ai",
							"self-hosting/sso"
						]
					},
					{
						"group": "Upgrade Guides",
						"pages": ["self-hosting/migration"]
