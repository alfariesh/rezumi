						]
					},
					{
						"group": "Integrations",
						"pages": [
							"guides/using-the-api",
							"guides/using-the-patch-api",
							"guides/json-resume-schema",
							"guides/using-the-mcp-server",
							"guides/using-webmcp",
							"guides/managing-applications-with-mcp",
							"guides/using-agent-skills",
							"guides/large-rpc-requests"
