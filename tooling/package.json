{
	"name": "@rezumi/tooling",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"docs:gen": "tsx semantic-css/generate-reference.ts",
		"test": "vp test run --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests",
		"typecheck": "tsrs --noEmit",
		"pdf:translations": "tsx locales/generate.ts",
		"icons:pdf": "tsx icons/hugeicons-pdf.ts",
		"templates:preview": "tsx --tsconfig ../tsconfig.json templates/preview.ts",
		"templates:previews": "tsx --tsconfig ../tsconfig.json templates/previews.ts",
		"templates:matrix": "tsx --tsconfig ../tsconfig.json templates/matrix.ts",
		"portfolio:cities": "tsx --tsconfig ../tsconfig.json portfolio/cities.ts",
		"portfolio:preview": "tsx --tsconfig ../tsconfig.json portfolio/preview.ts",
		"portfolio:previews": "tsx --tsconfig ../tsconfig.json portfolio/previews.ts",
		"portfolio:matrix": "tsx --tsconfig ../tsconfig.json portfolio/matrix.ts",
		"portfolio:seed": "tsx --tsconfig ../tsconfig.json portfolio/seed.ts",
		"icons:sync": "tsx icons/hugeicons-sync.ts",
		"seed:dev": "tsx seed/dev-seed.ts",
		"seed:career": "tsx seed/career-seed.ts",
		"seed:demo": "node seed/demo-data.mjs",
		"benchmark:ai": "tsx --tsconfig ../tsconfig.json benchmark/rezumi-ai.ts",
		"benchmark:ai:report": "tsx benchmark/report.ts"
	},
	"dependencies": {
		"@rezumi/pdf": "workspace:*",
		"@rezumi/portfolio": "workspace:*",
		"@rezumi/schema": "workspace:*"
	},
	"devDependencies": {
		"@lingui/format-po": "^6.10.1",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@playwright/test": "catalog:",
		"@rezumi/api": "workspace:*",
		"@rezumi/config": "workspace:*",
		"@rezumi/docx": "workspace:*",
		"@rezumi/resume": "workspace:*",
		"@rezumi/utils": "workspace:*",
		"@types/pg": "catalog:",
		"bcryptjs": "catalog:",
		"esbuild": "catalog:",
		"pg": "catalog:",
		"sharp": "^0.35.5",
		"tsrs": "catalog:",
		"tsx": "^4.23.15",
		"vite-plus": "catalog:",
		"wrangler": "catalog:"
	}
}
