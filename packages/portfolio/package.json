{
	"name": "@rezumi/portfolio",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/page.tsx",
		"./document": "./src/document.ts",
		"./draft": "./src/draft.ts",
		"./editor": "./src/editor.ts",
		"./edits": "./src/edits/index.ts",
		"./effects": "./src/effects/editor.ts",
		"./files": "./src/files.ts",
		"./checkup": "./src/checkup.ts",
