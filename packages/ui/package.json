{
	"name": "@rezumi/ui",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.tsx",
		"./postcss.config": "./postcss.config.mjs"
	},
	"scripts": {
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests"
	},
	"dependencies": {
		"@heroui-pro/react": "catalog:",
		"@heroui/react": "catalog:",
		"@heroui/styles": "catalog:",
		"@hugeicons/core-free-icons": "catalog:",
		"@hugeicons/react": "catalog:",
		"@phosphor-icons/web": "^2.1.2",
		"@rezumi/utils": "workspace:*",
		"react": "catalog:",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@rezumi/config": "workspace:*",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.3",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
