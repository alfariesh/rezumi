{
	"name": "@rezumi/schema",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./billing": "./src/billing/index.ts",
		"./career": "./src/career.ts",
		"./cover-letter/data": "./src/cover-letter/data.ts",
		"./applications/*": "./src/applications/*.ts",
		"./icons": "./src/icons.ts",
		"./portfolio/ai": "./src/portfolio/ai.ts",
		"./portfolio/blocks": "./src/portfolio/blocks.ts",
		"./portfolio/data": "./src/portfolio/data.ts",
		"./portfolio/default": "./src/portfolio/default.ts",
		"./portfolio/embed": "./src/portfolio/embed.ts",
		"./portfolio/files": "./src/portfolio/files.ts",
		"./portfolio/limits": "./src/portfolio/limits.ts",
		"./portfolio/links": "./src/portfolio/links.ts",
		"./portfolio/metric": "./src/portfolio/metric.ts",
		"./portfolio/moderation": "./src/portfolio/moderation.ts",
		"./portfolio/sections": "./src/portfolio/sections.ts",
		"./portfolio/statistics": "./src/portfolio/statistics.ts",
		"./portfolio/themes": "./src/portfolio/themes.ts",
		"./portfolio/video": "./src/portfolio/video.ts",
		"./resume/stylesheet": "./src/resume/stylesheet.ts",
		"./resume/*": "./src/resume/*.ts",
		"./templates": "./src/templates.ts"
	},
	"scripts": {
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests"
	},
	"dependencies": {
		"@rezumi/utils": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rezumi/config": "workspace:*",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
