	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rezumi/config": "workspace:*",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
