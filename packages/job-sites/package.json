{
	"name": "@rezumi/job-sites",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./sites": "./src/sites.ts",
		"./json-ld": "./src/json-ld.ts",
		"./capture": "./src/capture.ts"
	},
	"scripts": {
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
