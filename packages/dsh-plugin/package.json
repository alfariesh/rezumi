{
	"name": "dsh-plugin-rezumi",
	"version": "0.1.1",
	"description": "DeepSeek Harness plugin for Rezumi: bridges your resumes and job applications into a Harness session over MCP.",
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"mcp",
		"rezumi",
		"resume"
	],
	"license": "MIT",
	"author": "Salman Alfariesh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alfariesh/rezumi.git",
		"directory": "packages/dsh-plugin"
	},
	"homepage": "https://github.com/alfariesh/rezumi/tree/main/packages/dsh-plugin#readme",
	"bugs": {
		"url": "https://github.com/alfariesh/rezumi/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"cordis.patch.yml"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.5",
		"@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6 || ^0.2.0-rc.1",
		"@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.2.0-rc.1",
		"@deepseek-ai/schemastery": "^3.18.5"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "^4.0.5",
		"@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
		"@deepseek-ai/schemastery": "^3.18.5",
		"@rezumi/config": "workspace:*",
		"@rezumi/mcp": "workspace:*",
		"tsdown": "^0.23.3",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
